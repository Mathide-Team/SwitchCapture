#: switch_capture_gtk.py:809
msgid "Filtre de capture (tcpdump-like)"
msgstr "Capture filter (tcpdump-like)"

#: switch_capture_gtk.py:810
msgid "ex: host 10.0.0.5 and tcp port 22"
msgstr "e.g. host 10.0.0.5 and tcp port 22"

#: switch_capture_gtk.py:831
msgid "Importer un dépôt .bin..."
msgstr "Import a .bin repository..."

#: switch_capture_gtk.py:835
msgid "copie <source>/<modèle>/<version>/*.bin vers le dossier ci-dessus"
msgstr "copies <source>/<model>/<version>/*.bin to the folder above"

#: switch_capture_gtk.py:846
msgid "Choisir"
msgstr "Choose"

#: switch_capture_gtk.py:863
msgid "Choisir le dossier .bin à importer"
msgstr "Choose the .bin folder to import"

