msgstr "Import failed"

#: switch_capture_gtk.py:894
msgid "Voir le journal pour le détail."
msgstr "See the log for details."

#: switch_capture_gtk.py:929
msgid ""
"pour modifier une capture : supprimez-la puis recréez-la avec le formulaire "
"ci-dessous"
msgstr "to edit a capture: delete it then recreate it with the form below"

#: switch_capture_gtk.py:977
msgid ""
"slot IRF/châssis, modèle et .bin forcé : voir Préférences (menu ☰, en haut à "
"gauche)"
msgstr ""
"IRF/chassis slot, model and forced .bin: see Preferences (☰ menu, top left)"

#: switch_capture_gtk.py:992
msgid ""
"nécessaire pour comparer des traces prises à plusieurs points (client/"
"routeur/serveur)"
msgstr ""
"needed to compare traces taken at several points (client/router/server)"

#: switch_capture_gtk.py:1047
msgid "Tester la connexion"
msgstr "Test the connection"

#: switch_capture_gtk.py:1050
msgid "+ Ajouter cette capture à la liste"
msgstr "+ Add this capture to the list"

#: switch_capture_gtk.py:1054 switch_capture_gtk.py:1907
msgid "Enregistrer comme modèle"
msgstr "Save as template"

#: switch_capture_gtk.py:1057
msgid "Importer un modèle..."
msgstr "Import a template..."

